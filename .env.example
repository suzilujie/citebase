# CiteBase environment sample.
# start.ps1 copies this file to .env and fills in a random password on first run.

# --- database (docker compose reads these three) ---
POSTGRES_USER=citebase
POSTGRES_PASSWORD=CHANGE_ME_ON_FIRST_RUN
POSTGRES_DB=citebase

# Host-side connection string. Port 5440 maps to the container's 5432.
DATABASE_URL=postgres://citebase:CHANGE_ME_ON_FIRST_RUN@localhost:5440/citebase

# --- app ---
PORT=15640
TZ=Asia/Shanghai

# local  = deterministic hash embedding, works offline, no key needed
# openai = any OpenAI-compatible /embeddings endpoint
# NOTE: DeepSeek serves chat completions only (no /embeddings endpoint), so
#       keep this at "local" when answering with deepseek-chat.
EMBED_PROVIDER=local
EMBED_DIM=384

# auto       = use the LLM when a key is present, otherwise extractive
# extractive = always quote sentences from the retrieved chunks
# llm        = always call the chat model
ANSWER_MODE=auto

# Leave OPENAI_API_KEY empty to run fully offline (extractive answers).
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=deepseek-chat
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- retrieval ---
TOP_K=30
RRF_K=60
CONTEXT_K=8

# --- ingest ---
MAX_UPLOAD_MB=20
CHUNK_SIZE=700
CHUNK_OVERLAP=120
